# Canonical production origin; also the default when unset.
# Change only after a purchased custom domain is connected and HTTPS is verified.
NEXT_PUBLIC_SITE_URL=https://kai-rank.vercel.app

# Optional but recommended for reliable Google PageSpeed quota.
PAGESPEED_API_KEY=

# Optional HTTPS endpoint reserved for a future confirmed review-request workflow.
